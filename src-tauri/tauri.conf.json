{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipLink",
  "version": "0.1.0",
  "identifier": "com.localuser.cliplink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipLink",
        "width": 480,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "LocalUser",
    "copyright": "Copyright \u00A9 2026 LocalUser",
    "category": "Utility",
    "shortDescription": "ClipLink 两台电脑剪贴板同步",
    "longDescription": "ClipLink 通过 ZeroTier 网络在两台 Windows 电脑之间双向同步纯文字剪贴板。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
